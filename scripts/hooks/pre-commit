#!/bin/sh
# Pre-commit: fast formatting check (~2s)
# Catches unformatted code before it enters the commit history.
#
# Uses the Maven wrapper (./mvnw), not a globally installed `mvn`, so the gate
# works on Windows (Git Bash) and on machines without Maven on PATH.

cd "$(git rev-parse --show-toplevel)" || exit 1

echo ">> Running Spotless format check..."
if ! sh ./mvnw spotless:check -q 2>&1; then
    echo ""
    echo "[FAIL] Code formatting violations found."
    echo "       Run './mvnw spotless:apply' to auto-fix, then re-stage."
    exit 1
fi
echo "[OK] Formatting OK"